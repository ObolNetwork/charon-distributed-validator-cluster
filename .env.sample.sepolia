# This is a sample environment file that allows overriding default configuration defined
# in docker-compose.yml. Rename this file to `.env` and then uncomment and set any variable below.

# Overrides network for all the relevant services.
ETH2_NETWORK=sepolia

######### Execution Layer Config #########

# Nethermind host exposed ports.
#NETHERMIND_PORT_P2P=
#NETHERMIND_PORT_HTTP=
#NETHERMIND_PORT_ENGINE=

# Nethermind docker container image version.
# See available tags https://hub.docker.com/r/nethermind/nethermind/tags
#NETHERMIND_VERSION=

######### Consensus Layer Config #########

# Lighthouse beacon node host exposed ports.
#LIGHTHOUSE_PORT_P2P=
#LIGHTHOUSE_PORT_HTTP=
#LIGHTHOUSE_PORT_METRICS=

# Lighthouse beacon node execution engine endpoint.
#LIGHTHOUSE_EXECUTION_ENDPOINT=

# Lighthouse beacon node checkpoint sync URL used by consensus layer to fast sync.
LIGHTHOUSE_CHECKPOINT_SYNC_URL=https://checkpoint-sync.sepolia.ethpandaops.io/

# Lighthouse docker container image version, used by the beacon node and the vc0-lighthouse validator client.
# See available tags https://hub.docker.com/r/sigp/lighthouse/tags.
#LIGHTHOUSE_VERSION=

######### Validator Client Config #########

# Teku validator client docker container image version.
# See available tags https://hub.docker.com/r/consensys/teku/tags
#TEKU_VERSION=

# Lodestar validator client docker container image version, used by vc3-lodestar and vc5-lodestar.
# See available tags https://hub.docker.com/r/chainsafe/lodestar/tags
#LODESTAR_VERSION=

# Prysm validator client docker container image version.
# See available tags https://hub.docker.com/r/offchainlabs/prysm-validator/tags
#PRYSM_VERSION=

# The Nimbus validator client version is pinned in nimbus/Dockerfile.

# Fallback fee recipient for all validator clients, used only without charon's vc-config/proposer-config.json.
#FEE_RECIPIENT=

# Enables the builder API (MEV-boost) in charon and all validator clients.
#BUILDER_API_ENABLED=

# Lodestar builder selection: default, maxprofit, builderalways, builderonly, executiononly.
#LODESTAR_BUILDER_SELECTION=

######### MEV Config #########

# Comma separated list of MEV relays.
MEV_RELAYS=https://0xafa4c6985aa049fb79dd37010438cfebeb0f2bd42b115b89dd678dab0670c1de38da0c4e9138c9290a398ecd9a0b3110@boost-relay-sepolia.flashbots.net,https://0xb29cea86b298a62442dc3eb5574ff6bc05854a3f8ab57dbe5f36e6d02867bcdf018c2e7f0e6de26fd8fa837d4f0100b0@sepolia.agnostic-relay.net

# MEV-boost docker container image version.
# See available tags https://hub.docker.com/r/flashbots/mev-boost/tags
#MEV_BOOST_VERSION=

# MEV-boost timeouts in milliseconds.
#MEV_TIMEOUT_GETHEADER=
#MEV_TIMEOUT_GETPAYLOAD=
#MEV_TIMEOUT_REGVAL=

# Override the beacon node's builder endpoint.
#LIGHTHOUSE_BUILDER_URL=

######### Charon Config #########

# Charon docker container image version.
# See available tags https://hub.docker.com/r/obolnetwork/charon/tags.
#CHARON_VERSION=

# Define custom relays. One or more ENRs or an http URL that return an ENR. Use a comma separated list excluding spaces.
#CHARON_P2P_RELAYS=

# Connect to one or more external beacon nodes. Use a comma separated list excluding spaces.
#CHARON_BEACON_NODE_ENDPOINTS=

# Supply optional HTTP headers during beacon node requests (comma separated, key=value strings). These headers are sent to all beacon node endpoints, be sure to rely on trusted BNs only.
#CHARON_BEACON_NODE_HEADERS=

# Override the charon logging level; debug, info, warning, error.
#CHARON_LOG_LEVEL=

# Override the charon logging format; console, logfmt, json.
#CHARON_LOG_FORMAT=

# Advertise a custom external DNS hostname or IP address for libp2p peer discovery.
#CHARON_P2P_EXTERNAL_HOSTNAME=

# Nickname to identify this charon node on monitoring (max 32 characters).
#CHARON_NICKNAME=

# Charon host exposed addresses.
#CHARON_VALIDATOR_API_ADDRESS=
#CHARON_P2P_TCP_ADDRESS=
#CHARON_MONITORING_ADDRESS=

######### Monitoring Config #########

# Grafana docker container image version.
# See available tags https://github.com/grafana/grafana/releases.
#GRAFANA_VERSION=

# Prometheus docker container image version.
# See available tags https://github.com/prometheus/prometheus/releases.
#PROMETHEUS_VERSION=

# Prometheus remote write token used for accessing external prometheus (Obol hosted monitoring).
# prometheus/run.sh renders it into prometheus/prometheus.yml at start, so it never needs to be
# written into a tracked file. Required: prometheus exits without it.
#PROM_REMOTE_WRITE_TOKEN=
