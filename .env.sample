# This is a sample environment file that allows overriding default configuration defined
# in docker-compose.yml. Rename this file to `.env` and then uncomment and set any variable below.

######### Platåberget devnet (glamsterdam-devnet-8 / Gloas) #########
# This branch targets the Platåberget Gloas devnet. The clients use the
# ethpandaops devnet images and a custom network-config/ (genesis + bootnodes).
# The charon custom-network params have working defaults in docker-compose.yml
# (fork version 0x10733183, chain id 7091047534, genesis ts 1786622400), so you
# normally only need to set the monitoring token below.

# Devnet beacon checkpoint-sync endpoint (fast sync). Empty to sync from genesis.
#CHECKPOINT_SYNC_URL=https://checkpoint-sync.plataberget.ethpandaops.io

######### Geth (execution) Config #########

# ethpandaops geth devnet image tag (default: master).
#GETH_VERSION=
#GETH_PORT_P2P=
#GETH_PORT_HTTP=

######### Lighthouse Config #########

# ethpandaops lighthouse devnet image tag (default: unstable-fdcc865).
#LIGHTHOUSE_VERSION=
#LIGHTHOUSE_PORT_P2P=
#LIGHTHOUSE_PORT_HTTP=
#LIGHTHOUSE_PORT_METRICS=

######### Nimbus Config #########

# The nimbus VC image is built (nimbus/Dockerfile) from the gloas-capable
# ethpandaops beacon (for key import) + the statusim validator client.
# ethpandaops nimbus-eth2 devnet beacon tag (default: unstable).
#NIMBUS_BN_VERSION=
# statusim nimbus-validator-client tag (default: multiarch-v26.8.0).
#NIMBUS_VC_VERSION=

######### Proposer config #########

# Enable builder (MEV) registration + builder proposals in the VCs. The VCs read
# charon's generated proposer-config.json for per-validator fee recipient / gas
# limit; this toggles builder participation. Default: true.
#BUILDER_API_ENABLED=

######### Teku Config #########

# Teku validator client docker container image version, e.g. `latest` or `24.1.1`.
# See available tags https://hub.docker.com/r/consensys/teku/tags
#TEKU_VERSION=

# Teku beacon node host exposed ports
#TEKU_PORT_METRICS=

######### Charon Config #########

# Charon docker container image version, e.g. `v1.8.2`.
# See available tags https://hub.docker.com/r/obolnetwork/charon/tags.
#CHARON_VERSION=

# Define custom relays. One or more ENRs or an http URL that return an ENR. Use a comma separated list excluding spaces.
#CHARON_P2P_RELAYS=

# Connect to one or more external beacon nodes. Use a comma separated list excluding spaces.
#CHARON_BEACON_NODE_ENDPOINTS=

# Fallback beacon nodes, used only if the primary list is offline or unhealthy.
# e.g. point the primaries at a healthy public devnet BN and keep the local
# lighthouse as the fallback if the local BN is lagging.
#CHARON_FALLBACK_BEACON_NODE_ENDPOINTS=

# Pass HTTP Headers to all beacon node endpoints. (Comma separated, key=value strings).
#CHARON_BEACON_NODE_HEADERS=

# Override the charon logging level; debug, info, warning, error.
#CHARON_LOG_LEVEL=

# Override the charon logging format: console, logfmt, json.
#CHARON_LOG_FORMAT=

# Disable Jaeger tracing by setting an empty address.
#CHARON_JAEGER_ADDRESS=

# Advertise a custom external DNS hostname or IP address for UDP discv5 peer discovery.
#CHARON_P2P_EXTERNAL_HOSTNAME=

# Nickname to identify this charon node on monitoring (max 32 characters)
#CHARON_NICKNAME=

# Charon host exposed addresses
#CHARON_VALIDATOR_API_ADDRESS=
#CHARON_P2P_TCP_ADDRESS=
#CHARON_MONITORING_ADDRESS=

# Obol hosted-monitoring remote-write token. Also substitute it into
# prometheus/prometheus.yml (replace the $PROM_REMOTE_WRITE_TOKEN placeholder)
# so charon metrics ship to Obol's Grafana.
#PROM_REMOTE_WRITE_TOKEN=

#PROMETHEUS_VERSION=
#GRAFANA_VERSION=
#NODE_EXPORTER_VERSION=
#JAEGAR_VERSION=

# Monitoring host exposed ports
#MONITORING_PORT_PROMETHEUS=
#MONITORING_PORT_GRAFANA=
#MONITORING_PORT_JAEGER=
